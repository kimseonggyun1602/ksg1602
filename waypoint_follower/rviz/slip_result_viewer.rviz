Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: world
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Gazebo Reference Map Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /presentation/reference_map_points
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SLAM Map Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /presentation/slip_slam_map_points
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 30; 220; 70
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Length: 0.10
      Line Style: Lines
      Line Width: 0.06
      Name: Gazebo Ground Truth Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.03
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.10
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /presentation/gt_path
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 230; 45; 45
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Length: 0.10
      Line Style: Lines
      Line Width: 0.06
      Name: Localization and SLAM Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.06
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.10
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /presentation/slip_slam_path
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 62
      Target Frame: world
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
